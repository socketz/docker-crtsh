# ============================================================
# STAGE 1: Builder
# Builds libx509pq (C/PGXS), libocsppq and libzlintpq (plgo) and
# prepares the full certwatch_db tree + init scripts.
#
# NOTE: uses the glibc image (postgres:18), NOT alpine.  The
# plgo-generated extensions are Go shared objects
# (-buildmode=c-shared); on musl (alpine) PostgreSQL cannot load
# them ("initial-exec TLS resolves to dynamic definition").
# They work fine on glibc.
# ============================================================
FROM postgres:18 AS builder

ENV PG_MAJOR=18
ENV PATH=/usr/lib/postgresql/${PG_MAJOR}/bin:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        ca-certificates \
        curl \
        libssl-dev \
        postgresql-server-dev-${PG_MAJOR} \
    && rm -rf /var/lib/apt/lists/*

# Go >= 1.25 (required by plgo and by the go.mod of libocsppq/libzlintpq).
# We download the official toolchain from go.dev.
ARG GO_VERSION=1.26.7
RUN set -eux; \
    case "$(uname -m)" in \
        x86_64) set -- amd64 ffb5f8de10c62550dfddab66b36b57030721e0a44a3218e9e1181d7b59f121ca ;; \
        aarch64|arm64) set -- arm64 5a4ec883379d51ee9ce1040d5e87f8d35e20387574dd8c947feb01eabc3c1b37 ;; \
        *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-$1.tar.gz" -o /tmp/go.tgz; \
    echo "$2  /tmp/go.tgz" | sha256sum -c -; \
    tar -C /usr/local -xzf /tmp/go.tgz; \
    rm -f /tmp/go.tgz

ENV PATH=/usr/local/go/bin:/root/go/bin:$PATH

# plgo: PostgreSQL extension generator from Go/cgo.
RUN go install gitlab.com/microo8/plgo/cmd/plgo@latest \
    && command -v plgo

# ---- libx509pq (C + PGXS) ------------------------------------------
RUN git clone --depth 1 https://github.com/crtsh/libx509pq.git /tmp/libx509pq \
    && make -C /tmp/libx509pq with_llvm=no \
    && make -C /tmp/libx509pq install DESTDIR=/tmp/install with_llvm=no \
    && rm -rf /tmp/libx509pq

# ---- libocsppq (plgo) -------------------------------------------------
RUN git clone --depth 1 https://github.com/crtsh/libocsppq.git /tmp/libocsppq \
    && cd /tmp/libocsppq \
    && go get gitlab.com/microo8/plgo@latest \
    && make \
    && make -C build install DESTDIR=/tmp/install with_llvm=no \
    && mkdir -p /tmp/install/opt/certwatch/libocsppq \
    && cp /tmp/libocsppq/ocsp_embedded.fnc \
       /tmp/libocsppq/ocsp_randomserial_embedded.fnc \
       /tmp/install/opt/certwatch/libocsppq/ \
    && cd /tmp \
    && rm -rf /tmp/libocsppq

# ---- libzlintpq (plgo; the zlint build is long) -------------------------
RUN git clone --depth 1 https://github.com/crtsh/libzlintpq.git /tmp/libzlintpq \
    && cd /tmp/libzlintpq \
    && go get gitlab.com/microo8/plgo@latest \
    && make \
    && make -C build install DESTDIR=/tmp/install with_llvm=no \
    && mkdir -p /tmp/install/opt/certwatch/libzlintpq \
    && cp /tmp/libzlintpq/zlint_embedded.fnc \
       /tmp/install/opt/certwatch/libzlintpq/zlint_embedded.fnc \
    && cd /tmp \
    && rm -rf /tmp/libzlintpq

# ---- certwatch_db: full tree + patches ---------------------------------
# create_schema.sql uses relative includes (\i fnc/..., libocsppq/...,
# libzlintpq/...), so we copy the whole tree to /opt/certwatch.
RUN git clone --depth 1 https://github.com/crtsh/certwatch_db.git /tmp/certwatch_db \
    && sed -i \
        -e '/^CREATE DATABASE/d' \
        -e '/^\\connect/d' \
        -e '1i SET check_function_bodies TO off;' \
        -e 's/^CREATE ROLE certwatch WITH LOGIN;/ALTER ROLE certwatch WITH LOGIN;/' \
        -e 's/^\tPURPOSE_OID\t\t\ttext,$/\tPURPOSE_OID\t\t\ttext,\n\tOID_NAME\t\t\t\ttext,/' \
        -e 's/RAW_PLUSES_/UNENCODED_PLUS_/g' \
        /tmp/certwatch_db/sql/create_schema.sql \
    && mkdir -p /tmp/install/opt/certwatch \
    && tar -C /tmp/certwatch_db --exclude=.git -cf - . \
        | tar -C /tmp/install/opt/certwatch -xf - \
    && rm -rf /tmp/certwatch_db

# ---- Init scripts -------------------------------------------------------
COPY db/init/00_certwatch_extensions.sql \
     /tmp/install/docker-entrypoint-initdb.d/00_certwatch_extensions.sql
COPY db/init/10_certwatch_schema.sh \
     /tmp/install/docker-entrypoint-initdb.d/10_certwatch_schema.sh
COPY db/init/20_seed_ct_logs.sql \
     /tmp/install/docker-entrypoint-initdb.d/20_seed_ct_logs.sql

# ============================================================
# STAGE 2: Final image
# ============================================================
FROM postgres:18

COPY --from=builder /tmp/install /